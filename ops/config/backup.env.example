# SERVER/OPERATOR ONLY; never VITE_, never Git, never under /var/www.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SET_LOCALLY_ONLY
ETB_BACKUP_KEY_FILE=/etc/etoilebois/backup.key
PGSERVICE=etoilebois
PGSERVICEFILE=/etc/etoilebois/pg_service.conf
PGPASSFILE=/etc/etoilebois/pgpass
# pg_service.conf: dedicated Supabase connection with sslmode=verify-full,
# sslrootcert=/etc/etoilebois/supabase-ca.crt; no password in the connection URL.
# pgpass: HOST:PORT:DATABASE:USER:PASSWORD (0600, outside Git).
